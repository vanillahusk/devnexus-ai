# Community API. In the service-oriented setup this should point to Gateway.
VITE_API_BASE_URL=http://localhost:10010

# Optional. When omitted it is derived from VITE_API_BASE_URL.
VITE_WS_BASE_URL=ws://localhost:10010

# Optional external tool service. Leave empty to disable the Excel tool.
VITE_EXCEL_SERVICE_BASE_URL=

VITE_REQUEST_TIMEOUT_MS=15000

# Keep false until /ai/agent/api/stream has passed a real end-to-end check.
VITE_AGENT_STREAM_ENABLED=false
