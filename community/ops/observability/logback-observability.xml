<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Evidence containers are ephemeral. Console-only logging prevents the
         four JVMs from continuously writing rolling files into the WSL disk. -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="org.springframework" level="WARN"/>
    <logger name="com.alibaba.nacos" level="WARN"/>
    <logger name="org.apache.rocketmq" level="INFO"/>
    <logger name="com.github.paicoding.forum" level="INFO"/>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
